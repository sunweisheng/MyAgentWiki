project:
  name: "${project_name}"
  source_dir_name: "${source_dir_name}"
  source_dir_path: "${source_dir_path}"
  default_language: "zh"
  write_policy: "normal_auto_write"
  positioning: "agent_driven_local_llm_wiki"

workspace:
  schema_version: "v1"

paths:
  raw: "${raw_dir_relative_path}"
  assets: "${assets_dir_relative_path}"
  normalized: "normalized"
  chunks: "chunks"
  claims: "claims"
  wiki: "wiki"
  indexes: "indexes"
  state: "state"
  reviews: "reviews"
  logs: "logs"
  outputs: "outputs"

query:
  alias_expansion: true
  canonical_resolution: true
  preferred_language: "zh"

semantic:
  batch_scheduler:
    default_batch_size: 12
    max_retries: 1
  document_analysis:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.7
    batch_size: 10
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"
  claim_role:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 12
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"
  page_intent:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 8
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"

automation:
  mode: "safe_auto"
  philosophy: "prefer_agent_automation_until_human_judgment_is_required"
  post_ingest:
    review_auto: true
  review_auto:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.8
  image_to_text:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.7
  stable_promotion:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.85

rendering:
  readable_concept:
    mode: "llm_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 20
  overview:
    mode: "llm_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 20
  qa_note:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20
  concept_update:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20

agent:
  rule_source: "Agent.md"
  codex_entry: "AGENTS.md"
  claude_entry: "CLAUDE.md"
