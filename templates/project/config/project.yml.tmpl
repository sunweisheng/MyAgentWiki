project:
  name: "${project_name}"
  source_dir_name: "${source_dir_name}"
  source_dir_path: "${source_dir_path}"
  default_language: "zh"
  write_policy: "normal_auto_write"
  positioning: "agent_driven_local_llm_wiki"

workspace:
  schema_version: "v1"

paths:
  raw: "${raw_dir_relative_path}"
  assets: "${assets_dir_relative_path}"
  normalized: "normalized"
  chunks: "chunks"
  claims: "claims"
  wiki: "wiki"
  indexes: "indexes"
  state: "state"
  reviews: "reviews"
  logs: "logs"
  outputs: "outputs"

query:
  alias_expansion: true
  canonical_resolution: true
  preferred_language: "zh"

semantic:
  agent_cli_hook:
    # 默认使用包内保守模拟器；如需通过 Codex / Claude Code 调用真实 LLM，把具体任务 command 改为：
    #   - "${python_executable}"
    #   - "-m"
    #   - "myagentwiki.agent_cli_hook"
    # 并设置 MYAGENTWIKI_AGENT_CLI=codex|claude 以及对应 CLI 登录/模型环境变量。
    provider_env: "MYAGENTWIKI_AGENT_CLI"
    command_env: "MYAGENTWIKI_AGENT_CLI_COMMAND"
    timeout_env: "MYAGENTWIKI_AGENT_CLI_TIMEOUT_SECONDS"
  agent_online_hook:
    # 如需通过你自己提供的在线模型地址调用真实 LLM，把具体任务 command 改为：
    #   - "${python_executable}"
    #   - "-m"
    #   - "myagentwiki.agent_online_hook"
    # 并在当前工作区单独创建 `config/llm.local.yml`。
    config_path: "config/llm.local.yml"
  batch_scheduler:
    default_batch_size: 12
    max_retries: 1
  document_analysis:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.7
    batch_size: 10
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"
  claim_candidate_quality:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.75
    batch_size: 12
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"
  claim_role:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 12
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"
  page_intent:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 8
    model_key: "local-default"
    prompt_version: "v1"
    schema_version: "v1"

automation:
  mode: "safe_auto"
  philosophy: "prefer_agent_automation_until_human_judgment_is_required"
  post_ingest:
    review_auto: true
  review_auto:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.8
  image_to_text:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.7
  stable_promotion:
    strategy: "agent_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 45
    min_confidence: 0.85

rendering:
  readable_concept:
    mode: "llm_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 20
  overview:
    mode: "llm_assisted"
    command:
      - "${python_executable}"
      - "-m"
      - "myagentwiki.agent_hook"
    timeout_seconds: 20
  qa_note:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20
  concept_update:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20

agent:
  rule_source: "Agent.md"
  codex_entry: "AGENTS.md"
  claude_entry: "CLAUDE.md"
