project:
  name: "${project_name}"
  source_dir_name: "${source_dir_name}"
  source_dir_path: "${source_dir_path}"
  default_language: "zh"
  write_policy: "normal_auto_write"
  positioning: "agent_driven_local_llm_wiki"

workspace:
  schema_version: "v1"

paths:
  raw: "${raw_dir_relative_path}"
  assets: "${assets_dir_relative_path}"
  normalized: "normalized"
  chunks: "chunks"
  claims: "claims"
  wiki: "wiki"
  indexes: "indexes"
  state: "state"
  reviews: "reviews"
  logs: "logs"
  outputs: "outputs"

debug:
  retention_days: 7

query:
  alias_expansion: true
  canonical_resolution: true
  preferred_language: "zh"

llm:
  contract_version: "v2"
  routing:
    primary: "online"
    fallback: "cli"
  retry:
    online_max_retries: 2
    backoff_seconds: [1.0, 2.0]
    jitter_max_seconds: 0.25
    http_statuses: [408, 409, 429]
    http_status_min: 500
  context:
    document_max_chars: 24000
    image_max_bytes: 20971520
    image_mime_types: ["image/png", "image/jpeg", "image/webp", "image/gif"]
  cli:
    executable: "codex"
    timeout_seconds: 120
    model: ""
    executable_env: "MYAGENTWIKI_CODEX_BIN"
    model_env: "MYAGENTWIKI_CODEX_MODEL"
    timeout_env: "MYAGENTWIKI_CODEX_TIMEOUT_SECONDS"

semantic:
  batch_scheduler:
    default_batch_size: 12
  document_analysis:
    strategy: "llm_assisted"
    task_name: "document_analysis"
    timeout_seconds: 45
    min_confidence: 0.7
    batch_size: 10
    model_key: "llm-router-v1"
    prompt_version: "v2"
    schema_version: "v2"
  claim_candidate_quality:
    strategy: "llm_assisted"
    task_name: "claim_candidate_quality"
    timeout_seconds: 45
    min_confidence: 0.75
    batch_size: 12
    model_key: "llm-router-v1"
    prompt_version: "v2"
    schema_version: "v2"
  claim_role:
    strategy: "llm_assisted"
    task_name: "claim_role"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 12
    model_key: "llm-router-v1"
    prompt_version: "v2"
    schema_version: "v2"
  page_intent:
    strategy: "llm_assisted"
    task_name: "page_intent"
    timeout_seconds: 45
    min_confidence: 0.72
    batch_size: 8
    model_key: "llm-router-v1"
    prompt_version: "v2"
    schema_version: "v2"

automation:
  mode: "safe_auto"
  philosophy: "prefer_agent_automation_until_human_judgment_is_required"
  post_ingest:
    review_auto: true
  review_auto:
    strategy: "llm_assisted"
    task_name: "review_auto_decision"
    timeout_seconds: 45
    min_confidence: 0.8
  image_to_text:
    strategy: "llm_assisted"
    task_name: "describe_image"
    timeout_seconds: 45
    min_confidence: 0.7
  stable_promotion:
    strategy: "llm_assisted"
    task_name: "claim_stable_promotion"
    timeout_seconds: 45
    min_confidence: 0.85
  concept_candidate_review:
    strategy: "llm_assisted"
    task_name: "review_concept_candidate"
    timeout_seconds: 20
    min_confidence: 0.75

rendering:
  readable_concept:
    mode: "llm_assisted"
    task_name: "render_readable_concept_page"
    timeout_seconds: 20
  overview:
    mode: "llm_assisted"
    task_name: "render_workspace_overview_page"
    timeout_seconds: 20
  qa_note:
    mode: "disabled"
    timeout_seconds: 20
  concept_update:
    mode: "disabled"
    timeout_seconds: 20

agent:
  rule_source: "Agent.md"
  codex_entry: "AGENTS.md"
