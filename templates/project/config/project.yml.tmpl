project:
  name: "${project_name}"
  source_dir_name: "${source_dir_name}"
  source_dir_path: "${source_dir_path}"
  default_language: "zh"
  write_policy: "normal_auto_write"

paths:
  raw: "${raw_dir_relative_path}"
  normalized: "normalized"
  chunks: "chunks"
  claims: "claims"
  wiki: "wiki"
  indexes: "indexes"
  state: "state"
  reviews: "reviews"
  logs: "logs"
  outputs: "outputs"

query:
  alias_expansion: true
  canonical_resolution: true
  preferred_language: "zh"

rendering:
  readable_concept:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20
  overview:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20
  qa_note:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20
  concept_update:
    mode: "llm_assisted"
    command: []
    timeout_seconds: 20

agent:
  rule_source: "Agent.md"
  codex_entry: "AGENTS.md"
  claude_entry: "CLAUDE.md"
